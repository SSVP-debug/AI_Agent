# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key — free tier, no credit card required.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. gemini-2.5-flash is the recommended free-tier default
# (gemini-2.5-pro has a much tighter free daily quota — see README).
GEMINI_MODEL=gemini-2.5-flash

# Tavily API key — powers real web search for the researcher agent.
# Free tier available at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Directory where per-run outputs are written. Gitignored.
OUTPUT_DIR=output

# Optional: cap agent-level LLM call retries on transient errors (rate limit, timeout)
LLM_MAX_RETRIES=3
